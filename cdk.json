{
  "app": "python3 app.py",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/__pycache__", ".venv", "tests", "cdk.out"]
  },
  "context": {
    "keepsake:region": "us-east-1",
    "keepsake:alarmEmail": "",
    "keepsake:allowedOrigin": "",
    "keepsake:buildAndRunCostUsdPerMonth": "500",
    "keepsake:mode": "phase0",
    "keepsake:phase0WeeklySchedule": false,
    "keepsake:sourceInvocationLogsBucket": "",
    "keepsake:sourceInvocationLogsPrefix": "AWSLogs/",
    "keepsake:sourceInvocationLogsKmsKeyArn": "",
    "keepsake:githubRepo": "",
    "keepsake:githubBranch": "main",
    "keepsake:connectionArn": "",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:enablePartitionLiterals": true
  }
}
